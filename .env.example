# Configurazione Memora — copia in .env e adatta
# Nessun valore segreto va inserito qui: questo file è solo un template.
# Le variabili di questa sezione hanno precedenza su $MEMORA_DATA_DIR/config/settings.json.
# Un valore fornito dall'ambiente è bloccato nella pagina Impostazioni.

OPENROUTER_API_KEY=
# OpenCode Go chat/curator provider (secret separato)
OPENCODE_API_KEY=
# Modello OpenRouter predefinito (es. openrouter/free, openrouter/auto, anthropic/claude-3-haiku)
OPENROUTER_MODEL=openrouter/free
# Provider chat predefinito: openrouter oppure opencode-go.
MEMORA_CHAT_PROVIDER=openrouter
MEMORA_CHAT_REASONING_LEVEL=medium
# development = Vite + Fastify | production = Fastify serve anche la build React
NODE_ENV=development
# Default sicuro: nessuna esposizione automatica su Internet
MEMORA_HOST=127.0.0.1
MEMORA_PORT=3000
# Metti true solo quando Memora è raggiungibile via HTTPS (reverse proxy/Tailscale Serve).
MEMORA_COOKIE_SECURE=false
MEMORA_DATA_DIR=./data

# Retrieval: lexical (default), semantic oppure hybrid.
# Per semantic/hybrid abilitare embeddings e preparare il modello con pnpm embeddings:setup.
MEMORA_MEMORY_SEARCH_MODE=lexical
MEMORA_MEMORY_TOP_K=5
MEMORA_MEMORY_MAX_CHARS=4000
# Budget token stimato (caratteri/4) e diversità MMR 0..1 per la ricerca runtime.
MEMORA_MEMORY_MAX_TOKENS=1000
MEMORA_MEMORY_DIVERSITY=0.15
MEMORA_EMBEDDINGS_ENABLED=false
# Legacy: MEMORA_HYBRID_SEARCH_ENABLED=true seleziona hybrid solo se
# MEMORA_MEMORY_SEARCH_MODE non è impostata.
MEMORA_EMBEDDING_MODEL=Horizon-Labs/multilingual-embedding-small
MEMORA_EMBEDDING_DIMENSIONS=1024
# CWD isolato delle sessioni personal assistant (default: $MEMORA_DATA_DIR/runtime/assistant)
# MEMORA_ASSISTANT_CWD=./data/runtime/assistant
# Opzionale: override della directory della build frontend servita in production
# MEMORA_WEB_DIST_DIR=./apps/dist/web

# Memory Writer: l'estrazione automatica conservativa è OFF di default.
# Le richieste esplicite ("ricorda che...", "salva questa informazione...")
# producono comunque candidati da approvare manualmente nella Memory Inbox.
MEMORA_MEMORY_WRITER_ENABLED=false

# Curator LLM opzionale: invia al provider turni e pochi chunk correlati.
# I candidati richiedono sempre approvazione umana; nessun segreto va qui.
MEMORA_MEMORY_CURATOR_ENABLED=false
MEMORA_MEMORY_CURATOR_AUTO=true
MEMORA_MEMORY_CURATOR_PROVIDER=openrouter
MEMORA_MEMORY_CURATOR_REASONING_LEVEL=low
MEMORA_MEMORY_CURATOR_MODEL=
MEMORA_MEMORY_CURATOR_MIN_CONFIDENCE=0.75
MEMORA_MEMORY_CURATOR_MIN_SALIENCE=0.70

# Retention manuale per memory:history:prune (giorni). Non è una cancellazione
# automatica: il comando resta dry-run finché non viene usato --apply.
# MEMORA_MEMORY_HISTORY_RETENTION_DAYS=180

# Coda Curator durevole: tentativi e backoff. La coda vive in memory-inbox.
MEMORA_MEMORY_QUEUE_MAX_ATTEMPTS=3
MEMORA_MEMORY_QUEUE_RETRY_DELAY_MS=5000

# PDF HTML: Chromium headless usa le librerie in browser-libs. Preparale con
# `pnpm pdf:browser:setup`; senza di esse si usa il fallback PDFMake.
# MEMORA_PDF_BROWSER_LIBS=/percorso/browser-libs/usr/lib/x86_64-linux-gnu
# MEMORA_PDF_BROWSER_PATH=/percorso/chromium

# Telegram (opzionale): token del bot per notifiche/risultati automazioni.
# Preferisci Amministrazione → Telegram; i token nel secret store locale non
# vengono mai restituiti. Questa variabile vale solo per l’account predefinito legacy.
# MEMORA_TELEGRAM_BOT_TOKEN=

# Backup locale cifrato (default: directory accanto a MEMORA_DATA_DIR).
# MEMORA_BACKUP_DIR=./memora-backups
# Alternativa alla password configurata dalla UI; se impostata, la UI non la modifica.
# MEMORA_BACKUP_PASSWORD=
